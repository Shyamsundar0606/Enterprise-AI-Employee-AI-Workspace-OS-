APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=ai_workspace
POSTGRES_USER=ai_workspace
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://ai_workspace:change-me-in-production@postgres:5432/ai_workspace
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
LLM_PROVIDER=OLLAMA
OLLAMA_URL=http://host.docker.internal:11434
DEFAULT_MODEL=qwen3
TEMPERATURE=0.7
MAX_TOKENS=512
DEFAULT_AGENT=general
LANGGRAPH_DEBUG=true
AGENT_TIMEOUT=120
RAG_ENABLED=true
MAX_DOCUMENT_SIZE_MB=10
DOCUMENT_STORAGE_PATH=/app/data/documents
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.4
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_TIMEOUT=30
MULTI_AGENT_ENABLED=true
MAX_AGENT_DELEGATIONS=4
MAX_AGENT_STEPS=8
MAX_AGENT_TASK_LENGTH=4000
INTEGRATIONS_ENABLED=true
LOCAL_CONNECTORS_ENABLED=true
MCP_ENABLED=true
MCP_REQUEST_TIMEOUT_SECONDS=15
CONNECTOR_MAX_RESULT_SIZE=50000
WORKSPACE_CONNECTOR_PATH=/app/data/workspace
CONNECTOR_AUDIT_ENABLED=true
OPENAI_API_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
